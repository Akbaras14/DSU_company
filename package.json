{
  "name": "nursey",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @dsu/web",
    "start": "npm run start --workspace @dsu/web",
    "lint": "npm run lint --workspace @dsu/web",
    "typecheck": "npm run typecheck --workspace @dsu/api && npm run typecheck --workspace @dsu/web",
    "test": "tsx --test packages/contracts/tests/*.test.ts apps/web/features/storefront/*.test.ts",
    "format": "prettier --write apps/web packages/contracts docs",
    "dev:web": "npm run dev --workspace @dsu/web",
    "dev:api": "npm run dev --workspace @dsu/api",
    "db:generate": "npm run db:generate --workspace @dsu/api",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy --schema apps/api/prisma/schema.prisma",
    "admin:create": "npm run admin:create --workspace @dsu/api",
    "catalog:import": "npm run catalog:import --workspace @dsu/api",
    "locations:import": "npm run locations:import --workspace @dsu/api",
    "test:api": "npm run test --workspace @dsu/api",
    "test:frontend": "playwright test --config playwright.config.ts",
    "test:customer": "playwright test --config playwright.customer.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.6",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
